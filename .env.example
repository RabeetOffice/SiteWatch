# SiteWatch environment configuration
# Copy this file to .env and adjust the values. NEVER commit .env or expose it publicly.

APP_ENV=production
APP_DEBUG=false
APP_URL=https://monitor.example.com
APP_TIMEZONE=Asia/Karachi
# 32 random bytes, base64 encoded. Generated automatically by install.php. Used to encrypt SMTP/Telegram credentials.
APP_KEY=

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sitewatch
DB_USER=sitewatch
DB_PASSWORD=

# Minutes of inactivity before an admin session expires
SESSION_LIFETIME=480

# Login rate limiting
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Logging: debug | info | notice | warning | error
LOG_LEVEL=info
LOG_MAX_FILES=14

# SSRF protection. Leave false unless you intentionally monitor internal/private-network sites
# from a trusted environment. When false, targets resolving to private, loopback, link-local
# or metadata addresses are rejected (including redirect destinations).
MONITOR_ALLOW_PRIVATE=false

# Maximum number of due websites processed by a single cron run
MONITOR_MAX_PER_RUN=300
