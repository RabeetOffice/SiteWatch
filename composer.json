{
    "name": "sitewatch/sitewatch",
    "description": "SiteWatch - Professional WordPress website monitoring platform for agencies",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_mysql": "*",
        "guzzlehttp/guzzle": "^7.9",
        "phpmailer/phpmailer": "^6.9",
        "monolog/monolog": "^3.7",
        "vlucas/phpdotenv": "^5.6",
        "dragonmantank/cron-expression": "^3.4",
        "composer/ca-bundle": "^1.5"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/Core/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.2.12"
        }
    },
    "scripts": {
        "test": "phpunit --colors=always",
        "lint": "php -l bootstrap.php"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
