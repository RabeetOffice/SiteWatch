# ============================================================================
# SiteWatch - Apache configuration
# Works on XAMPP, cPanel and standard Apache 2.2/2.4 hosts.
# ============================================================================

Options -Indexes
ServerSignature Off

# ---------------------------------------------------------------------------
# Block direct web access to application internals
# ---------------------------------------------------------------------------
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(app|config|database|storage|cron|vendor|tests)(/|$) - [F,L]
    RewriteRule ^(\.env|\.env\.example|composer\.json|composer\.lock|phpunit\.xml|README\.md)$ - [F,L]

    # Client report share links: /r/<token> and /r/<token>.pdf
    RewriteRule ^r/([a-f0-9]{32})(\.pdf)?$ report.php?t=$1&pdf=$2 [L,QSA]
</IfModule>

# Sensitive files (belt and braces in case mod_rewrite is unavailable)
<FilesMatch "^(\.env|\.env\.example|\.htaccess|\.gitignore|composer\.json|composer\.lock|phpunit\.xml)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

<FilesMatch "\.(log|lock|sql|md|bak|dist|ini|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# ---------------------------------------------------------------------------
# Security headers (also set by PHP; harmless duplication)
# ---------------------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ---------------------------------------------------------------------------
# Installable app (PWA)
# ---------------------------------------------------------------------------
AddType application/manifest+json .webmanifest
AddType font/woff2 .woff2

# ---------------------------------------------------------------------------
# Static asset caching
# Asset URLs carry the version and file time (?v=…), so browsers may keep them for a year. The service
# worker and the manifest must always be revalidated so updates reach installed apps.
# ---------------------------------------------------------------------------
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType text/css "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 30 days"
    ExpiresByType image/png "access plus 30 days"
</IfModule>
<IfModule mod_headers.c>
    <FilesMatch "\.(css|js|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "^(sw\.js|manifest\.webmanifest|offline\.html)$">
        Header set Cache-Control "no-cache"
    </FilesMatch>
</IfModule>

# Compress text responses
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript text/javascript application/json application/manifest+json image/svg+xml
</IfModule>

DirectoryIndex index.php
